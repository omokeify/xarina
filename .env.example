# Copy to .env.local. Local values come from `pnpm db:start` (prints the API URL and anon key).

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase's newer names are also accepted: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# is an alias for the anon key, and SUPABASE_SECRET_KEY an alias for the service
# role key. Set either pair, not both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — never import into client components
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Phase 3). Paystack secret key; webhook URL: <site>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Which provider takes each currency (open decision: GBP/USD). NGN defaults to paystack;
# a currency with no provider cannot be checked out.
# PAYMENT_PROVIDER_NGN=paystack
# PAYMENT_PROVIDER_GBP=
# PAYMENT_PROVIDER_USD=

# Email (Resend). EMAIL_FROM must be an address on a domain verified in Resend.
# To test with no domain yet, use EMAIL_FROM="Xarina <onboarding@resend.dev>" (Resend only delivers
# that to your own account email). Then, with `pnpm dev` running, open
# /api/dev/send-test-emails?to=<your email> to send all templates. Logos load only when
# NEXT_PUBLIC_SITE_URL is publicly reachable (a deployed URL or a tunnel), not localhost.
# EMAIL_REPLY_TO receives replies, including requests to stop drop alerts.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Shared secret for the pg_cron job that calls /api/internal/drop-notifications.
# Store the same value in Supabase Vault as `cron_secret`, with the site URL as `site_url`.
CRON_SECRET=

# Mux product video (optional: without these, video upload is disabled in admin).
# Webhook URL to register in Mux: <site>/api/mux/webhook
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Tracking (Phase 6). Meta tools are free; ad spend is billed by Meta.
# Pixel ID is public, CAPI token is a secret. Purchase is sent only from the paid
# webhook, with event_id = order id; the browser never sends a Purchase event.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional; defaults to v27.0. Graph API versions change; keep this current.
# META_GRAPH_API_VERSION=v27.0

# PostHog (free tier: 1M analytics events/month). POSTHOG_PROJECT_KEY is the
# public "Project API Key"/token starting phc_ (Settings -> Project); it is sent
# to the browser and cannot read data. Do NOT use a personal API key (phx_...):
# that is a secret for PostHog's management API and cannot capture events.
# Host is your Cloud region (us.i.posthog.com or eu.i.posthog.com).
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Email footer details (all optional; a footer leaves out anything not set).
# EMAIL_INSTAGRAM_URL=https://instagram.com/...
# EMAIL_WHATSAPP_URL=https://wa.me/234...
# EMAIL_BUSINESS_ADDRESS=

# Anti-abuse rate limits on public forms and checkout start (lib/rate-limit.ts).
# On in production; off in development. Set to "off" only for the e2e test server.
# RATE_LIMITS=off
